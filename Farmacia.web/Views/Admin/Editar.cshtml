@model Farmacia.Entidades.Usuario
@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="mb-4 text-center text-primary">@ViewData["Title"]</h2>

    <form asp-action="Editar" method="post" novalidate>
        <input type="hidden" asp-for="Id_Usuario" />

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" required />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Correo_Electronico" class="form-label">Correo Electrónico</label>
            <input asp-for="Correo_Electronico" type="email" class="form-control" required />
            <span asp-validation-for="Correo_Electronico" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Contraseña" class="form-label">Contraseña</label>
            <input asp-for="Contraseña" type="password" class="form-control" required />
            <span asp-validation-for="Contraseña" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="id_Rol" class="form-label">Rol ID</label>
            <input asp-for="id_Rol" type="number" min="1" class="form-control" required />
            <span asp-validation-for="id_Rol" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Listar" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>

    <div class="mt-3 text-center">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-link">Volver al Inicio</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
