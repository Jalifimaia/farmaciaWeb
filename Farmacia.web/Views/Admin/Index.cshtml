@{
    ViewData["Title"] = "Bienvenido Administrador";
}

<h2 style="text-align: center">@ViewData["Title"]</h2>

<div class="contenedor-botones-columna">

    <a asp-controller="Admin" asp-action="Crear" class="btn btn-primary">Crear Usuario</a>

    <a asp-controller="Admin" asp-action="Buscar" class="btn btn-primary">Buscar Usuario</a>
    
     <a asp-controller="Admin" asp-action="Listar" class="btn btn-primary">Listar Usuario</a>

    
</div>

<form asp-controller="Home" asp-action="CerrarSesion" method="post">
    <button type="submit" class="btn btn-secondary btn-sm">Cerrar Sesión</button>
</form>








