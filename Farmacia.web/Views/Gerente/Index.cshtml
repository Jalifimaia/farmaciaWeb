@{
    ViewData["Title"] = "Panel Gerente";
}

<div class="container mt-5" style="max-width: 400px;">
    <h2 class="text-center mb-4">@ViewData["Title"]</h2>

    <div class="d-grid gap-3 mb-4">
        <a href="@Url.Action("ReporteInventario", "Gerente")" class="btn btn-primary btn-lg d-flex align-items-center justify-content-center">
            <span class="me-2 fs-4">📦</span> Reporte de Inventario
        </a>
        <a href="@Url.Action("ReporteAlertas", "Gerente")" class="btn btn-warning btn-lg d-flex align-items-center justify-content-center">
            <span class="me-2 fs-4">⚠️</span> Reporte de Alertas
        </a>
        <a href="@Url.Action("ReporteVentas", "Gerente")" class="btn btn-success btn-lg d-flex align-items-center justify-content-center">
            <span class="me-2 fs-4">💰</span> Reporte de Ventas
        </a>
    </div>

    <form asp-controller="Home" asp-action="CerrarSesion" method="post" class="text-center">
        <button type="submit" class="btn btn-danger btn-sm px-4">Cerrar Sesión</button>
    </form>
</div>
