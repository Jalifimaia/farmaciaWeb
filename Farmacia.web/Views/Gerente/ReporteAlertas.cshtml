@model List<Farmacia.Entidades.Medicamento>
@{
    ViewData["Title"] = "Reporte de Alertas";
}

<div class="container mt-4">
    <h2 class="mb-4 text-warning">⚠️ Reporte de Alertas</h2>

    <div class="mb-3">
        <div class="btn-group" role="group" aria-label="Filtros de alertas">
            <a href="@Url.Action("ReporteAlertas", new { tipo = "stock" })" class="btn btn-outline-danger">Solo Stock Crítico</a>
            <a href="@Url.Action("ReporteAlertas", new { tipo = "vencimiento" })" class="btn btn-outline-warning">Solo Próximos a Vencer</a>
            <a href="@Url.Action("ReporteAlertas", new { tipo = "ambos" })" class="btn btn-outline-primary">Todos</a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-success mt-4" role="alert">
            ✅ No hay alertas actuales.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>ID</th>
                    <th>Stock</th>
                    <th>Fecha de Vencimiento</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.Nombre</td>
                        <td>@m.Id_Medicamento</td>
                        <td>
                            @if (m.Stock <= 5)
                            {
                                <span class="badge bg-danger">@m.Stock</span>
                            }
                            else
                            {
                                @m.Stock
                            }
                        </td>
                        <td>
                            @if (m.Fecha_Vencimiento <= DateTime.Now.AddDays(30))
                            {
                                <span class="text-danger fw-bold">@m.Fecha_Vencimiento.ToShortDateString()</span>
                            }
                            else
                            {
                                @m.Fecha_Vencimiento.ToShortDateString()
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-controller="Gerente" asp-action="Index" class="btn btn-secondary mt-4">Volver</a>
</div>
