@model List<Farmacia.Entidades.Medicamento>
@{
    ViewData["Title"] = "Reporte de Alertas";
}

<h2>⚠️ Reporte de Alertas</h2>

<div>
    <a href="@Url.Action("ReporteAlertas", new { tipo = "stock" })">Solo Stock Crítico</a> |
    <a href="@Url.Action("ReporteAlertas", new { tipo = "vencimiento" })">Solo Próximos a Vencer</a> |
    <a href="@Url.Action("ReporteAlertas", new { tipo = "ambos" })">Todos</a>
</div>

@if (Model.Count == 0)
{
    <p class="mt-3">✅ No hay alertas actuales.</p>
}
else
{
    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>ID</th>
                <th>Stock</th>
                <th>Fecha de Vencimiento</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Nombre</td>
                    <td>@m.Id_Medicamento</td>
                    <td>@m.Stock</td>
                    <td>@m.Fecha_Vencimiento.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}
