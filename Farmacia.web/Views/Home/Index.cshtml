@model Farmacia.web.Models.LoginViewModel

@{
    ViewData["Title"] = "Inicio de sesión";
}

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow p-4" style="min-width: 320px; max-width: 400px; width: 100%;">
        <h2 class="text-center mb-4 text-primary">@ViewData["Title"]</h2>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewBag.Mensaje
            </div>
        }

        <form asp-action="Login" method="post" novalidate>
            <div class="mb-3">
                <label asp-for="correo" class="form-label">Correo electrónico</label>
                <input asp-for="correo" class="form-control" type="email" placeholder="tu@correo.com" autofocus />
                <span asp-validation-for="correo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="contrasenia" class="form-label">Contraseña</label>
                <input asp-for="contrasenia" class="form-control" type="password" placeholder="Contraseña" />
                <span asp-validation-for="contrasenia" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
