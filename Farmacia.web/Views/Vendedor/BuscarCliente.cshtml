@model List<Farmacia.Entidades.Cliente>

@{
    ViewData["Title"] = "Buscar Cliente";
}

<h2>Buscar Cliente</h2>

<form asp-action="BuscarCliente" method="post">
    <input type="text" name="criterio" placeholder="Ingrese nombre, apellido, email, DNI o tipo" />
    <button type="submit">Buscar</button>
</form>

@if (ViewBag.Mensaje != null)
{
    <p>@ViewBag.Mensaje</p>
}

@if (Model != null && Model.Count > 0)
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Correo Electrónico</th>
                <th>DNI</th>
                <th>Tipo Cliente</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Id_Cliente</td>
                    <td>@cliente.Nombre</td>
                    <td>@cliente.Apellido</td>
                    <td>@cliente.Correo_Electronico</td>
                    <td>@cliente.DNI</td>
                    <td>@cliente.Tipo_Cliente</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay clientes para mostrar.</p>
}
<a asp-controller="Admin" asp-action="Index" class="btn btn-secondary mt-3">Volver</a>