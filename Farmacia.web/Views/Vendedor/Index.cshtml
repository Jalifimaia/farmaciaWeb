@{
    ViewData["Title"] = "Bienvenido Vendedor";
}

<h2 class="text-center my-4">@ViewData["Title"]</h2>

<div class="d-flex flex-column align-items-center gap-3 mx-auto" style="max-width: 260px;">
    <a asp-controller="Vendedor" asp-action="RegistrarCliente" class="btn btn-warning btn-lg w-100">Registrar Cliente</a>
    <a asp-controller="Vendedor" asp-action="BuscarCliente" class="btn btn-warning btn-lg w-100">Buscar Cliente</a>
    <a asp-controller="Vendedor" asp-action="RegistrarVenta" class="btn btn-warning btn-lg w-100">Registrar Venta</a>
    <a asp-controller="Vendedor" asp-action="ListarVentas" class="btn btn-warning btn-lg w-100">Listar Ventas</a>
    <a asp-controller="Vendedor" asp-action="ListarCliente" class="btn btn-warning btn-lg w-100">Listar Clientes</a>
</div>

<form asp-controller="Home" asp-action="CerrarSesion" method="post" class="text-center mt-4">
    <button type="submit" class="btn btn-secondary btn-sm px-4">Cerrar Sesión</button>
</form>
