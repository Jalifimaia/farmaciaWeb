@{
    ViewData["Title"] = "Bienvenido Vendedor";
}

<h2 style="text-align: center">@ViewData["Title"]</h2>

<style>
    .contenedor-botones-columna {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
        max-width: 220px; /* ajustable */
        margin: 0 auto; /* centrar horizontalmente */
    }
</style>

<div class="contenedor-botones-columna">
    <a asp-controller="Vendedor" asp-action="RegistrarCliente" class="btn btn-warning">Registrar Cliente</a>
    <a asp-controller="Vendedor" asp-action="BuscarCliente" class="btn btn-warning">Buscar Cliente</a>
    <a asp-controller="Vendedor" asp-action="RegistrarVenta" class="btn btn-warning">Registrar Venta</a>
    <a asp-controller="Vendedor" asp-action="ModificarVenta" class="btn btn-warning">Modificar Venta</a>
    <a asp-controller="Vendedor" asp-action="BuscarVentaPorID" class="btn btn-warning">Buscar Venta por ID</a>
    <a asp-controller="Vendedor" asp-action="ListarVentas" class="btn btn-warning">Listar Ventas</a>
    <a asp-controller="Vendedor" asp-action="EliminarVenta" class="btn btn-warning">Eliminar Venta</a>
</div>

<form asp-controller="Home" asp-action="CerrarSesion" method="post" style="margin-top: 30px; text-align: center;">
    <button type="submit" class="btn btn-secondary btn-sm">Cerrar Sesión</button>
</form>
