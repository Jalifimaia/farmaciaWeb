@model RegistrarVentaViewModel
@{
    ViewData["Title"] = "Registrar Venta";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (ViewBag.MensajeExito != null)
{
    <div class="alert alert-success text-center">
        @ViewBag.MensajeExito
    </div>
}


<div class="container mt-4">
    <h2 class="text-center mb-4">Registrar Venta</h2>

    @if (ViewBag.MensajeExito != null)
    {
        <div class="alert alert-success text-center">
            @ViewBag.MensajeExito
        </div>
    }

    @if (ViewBag.Mensaje != null)
    {
        <div class="alert alert-danger text-center">
            @ViewBag.Mensaje
        </div>
    }

    <form asp-action="RegistrarVenta" method="post" class="border rounded p-4 shadow">
        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="Id_Cliente" class="form-label">Cliente</label>
                <select asp-for="Id_Cliente" asp-items="Model.Clientes" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="Id_Medicamento" class="form-label">Medicamento</label>
                <select asp-for="Id_Medicamento" asp-items="Model.Medicamentos" class="form-select"></select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Cantidad" class="form-label">Cantidad</label>
            <input asp-for="Cantidad" class="form-control" type="number" min="1" />
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" name="action" value="Agregar" class="btn btn-outline-primary">
                ➕ Agregar Medicamento
            </button>
            <button type="submit" name="action" value="Finalizar" class="btn btn-success">
                💾 Finalizar Venta
            </button>
        </div>
    </form>

    @if (Model.Detalles != null && Model.Detalles.Count > 0)
    {
        <h4 class="mt-5">📋 Detalles de la Venta</h4>
        <table class="table table-bordered table-striped mt-3">
            <thead class="table-dark text-center">
                <tr>
                    <th>Medicamento</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody class="text-center">
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td>@detalle.Medicamento?.Nombre</td>
                        <td>@detalle.Cantidad</td>
                        <td>@detalle.Precio_Unitario</td>
                        <td>@detalle.SubTotal</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-secondary text-end">
                    <td colspan="3"><strong>Total:</strong></td>
                    <td>
                        @Model.Detalles.Sum(d => d.SubTotal)
                    </td>
                </tr>
            </tfoot>
        </table>
    }
</div>
<a asp-controller="Vendedor" asp-action="Index" class="btn btn-secondary mt-3">Volver</a>